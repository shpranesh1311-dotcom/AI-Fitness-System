# Copy this file to .env and adjust as needed.

# Default: SQLite, zero config, works immediately.
DATABASE_URL=sqlite:///./fitness.db

# To use MySQL instead (as originally planned), comment the line above and
# uncomment / edit the line below with your own credentials:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/ai_fitness_db

CORS_ORIGINS=http://localhost:3000
